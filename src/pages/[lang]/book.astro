---
import { getCollection } from 'astro:content';
import { LANGS, t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){ return LANGS.map((lang)=>({ params:{ lang }})); }
const { lang } = Astro.params;
const tours = (await getCollection('tours')).sort((a,b)=>a.data.order-b.data.order);
const T = tours.map((tr)=>({ slug:tr.slug, price:tr.data.priceFrom, days:tr.data.durationDays, route:tr.data.route||'', title:(tr.data[lang]??tr.data.en).title }));
const opts = [
  ['easy_rider','opt_er_t','opt_er_b','opt_er_d'],
  ['self_drive','opt_sd_t','opt_sd_b','opt_sd_d'],
].map(([k,a,b,c])=>({ key:k, title:t(lang,a), badge:t(lang,b), desc:t(lang,c) }));
const L = {
  lang, for:t(lang,'q_for'), travelers:t(lang,'q_travelers'), days:t(lang,'days'),
  insurance:t(lang,'q_insurance'), total:t(lang,'q_total'),
  erSurcharge:`${t(lang,'opt_er_t')} ${t(lang,'q_surcharge')}`,
  carLabel:`${t(lang,'opt_pc_t')} (+50%)`, bikeLabel:`${t(lang,'opt_pb_t')} (+40%)`,
  backLabel:t(lang,'book_back'), backHint:t(lang,'book_back_hint'),
  accomHint:t(lang,'accom_hint'), accomDorm:t(lang,'accom_dorm'),
  accomTitle:t(lang,'accom_title'), accomPrivate:t(lang,'accom_private'),
  inclBack:t(lang,'q_incl_back'), busShort:t(lang,'q_bus_short'), pax:t(lang,'q_pax'),
  people: lang==='fr' ? 'pers' : (lang==='vi' ? 'khách' : 'people'),
  cta:t(lang,'book_cta'), okMsg:t(lang,'ok_msg'), errMsg:t(lang,'err_msg'), errContact:t(lang,'err_contact'),
};
const seoMap = {
  en:{ t:"Book Your Ha Giang Loop Tour — Live Quote | Tien Tour", d:"Build your Ha Giang adventure and get a live quote. No payment until we confirm availability." },
  fr:{ t:"Réserver votre boucle de Ha Giang — devis en direct | Tien Tour", d:"Composez votre aventure à Ha Giang et obtenez un devis en direct. Aucun paiement avant confirmation des disponibilités." },
  vi:{ t:"Đặt tour cung đường Hà Giang — báo giá trực tiếp | Tien Tour", d:"Thiết kế hành trình Hà Giang và nhận báo giá trực tiếp. Chưa thanh toán cho đến khi xác nhận lịch trống." },
};
const seo = seoMap[lang] ?? seoMap.en;
---
<Base title={seo.t} description={seo.d} lang={lang}>
  <section class="book-hero"><div class="wrap">
    <div class="eyebrow">{t(lang,'book_eyebrow')}</div>
    <h1>{t(lang,'book_title')}</h1>
    <p>{t(lang,'book_sub')}</p>
  </div></section>

  <div class="wrap book-grid">
    <div>
      <div class="step-h"><span class="n italic">01</span><h2>{t(lang,'book_s1')}</h2></div>
      <div class="opts">
        {opts.map((o,i)=>(
          <div class={"opt"+(i===0?" sel":"")} data-opt={o.key}>
            <div class="t"><h3>{o.title}</h3><span class="badge">{o.badge}</span></div>
            <p>{o.desc}</p>
          </div>
        ))}
      </div>
      <button type="button" class="opt-rental" id="rentalCard">
        <div class="t"><h3>{t(lang,'rental_title')}</h3><span class="badge rent">{t(lang,'rental_badge')}</span></div>
        <p>{t(lang,'rental_sub')}</p>
        <span class="rental-link">{t(lang,'rental_cta')}</span>
      </button>

      <div class="step-h"><span class="n italic">02</span><h2>{t(lang,'book_s2')}</h2></div>
      <div id="tourlist">
        {T.map((tr,i)=>(
          <div class={"tour-opt"+(i===0?" sel":"")} data-slug={tr.slug} data-price={tr.price} data-days={tr.days}>
            <div class="th"></div>
            <div><h3>{tr.title}</h3>
              <div class="meta">{tr.days} {t(lang,'days')} · {t(lang,'from')} {tr.price.toLocaleString('en-US').replace(/,/g,'\u00a0')} VND/pers.</div>
              {tr.route && <div class="route">{tr.route}</div>}
            </div>
          </div>
        ))}
      </div>

      <div class="step-h"><span class="n italic">03</span><h2>{t(lang,'book_travelers')}</h2></div>
      <div class="travelers">
        <button id="tmin" type="button" aria-label="-">−</button>
        <span class="v" id="tval">2</span>
        <button id="tplus" type="button" aria-label="+">+</button>
      </div>
      <div class="backpax" id="backpax" style="display:none">
        <div class="bp-label">{t(lang,'book_back')} <small id="bpHint">{t(lang,'book_back_hint')}</small></div>
        <div class="travelers">
          <button id="bmin" type="button" aria-label="-">−</button>
          <span class="v" id="bval">0</span>
          <button id="bplus" type="button" aria-label="+">+</button>
        </div>
      </div>

      <div class="accom">
        <div class="ac-title">{t(lang,'accom_title')}</div>
        <div class="ac-row">
          <div class="ac-lbl">{t(lang,'accom_private')} <small id="roomsHint"></small></div>
          <div class="travelers sm">
            <button id="rmin" type="button" aria-label="-">−</button>
            <span class="v" id="rval">1</span>
            <button id="rplus" type="button" aria-label="+">+</button>
          </div>
        </div>
        <div class="ac-row">
          <div class="ac-lbl">{t(lang,'accom_dorm')} <small id="bedsHint"></small></div>
          <div class="travelers sm">
            <button id="dmin" type="button" aria-label="-">−</button>
            <span class="v" id="dval">0</span>
            <button id="dplus" type="button" aria-label="+">+</button>
          </div>
        </div>
      </div>

      <div class="step-h"><span class="n italic">04</span><h2>{t(lang,'book_s4')}</h2></div>
      <div class="form">
        <div class="field"><label for="f_name">{t(lang,'f_name')}</label><input id="f_name" type="text" autocomplete="name" /></div>
        <div class="row2">
          <div class="field"><label for="f_email">{t(lang,'f_email')}</label><input id="f_email" type="email" autocomplete="email" /></div>
          <div class="field"><label for="f_whatsapp">{t(lang,'f_whatsapp')}</label><input id="f_whatsapp" type="tel" /></div>
        </div>
        <div class="field"><label for="f_date">{t(lang,'f_date')}</label><input id="f_date" type="date" /></div>
        <div class="field"><label for="f_country">{t(lang,'f_country')}</label><input id="f_country" type="text" autocomplete="country-name" /></div>
        <div class="field"><label for="f_message">{t(lang,'f_message')}</label><textarea id="f_message"></textarea></div>
      </div>

      <div class="step-h"><span class="n italic">05</span><h2>{t(lang,'book_bus_title')}</h2></div>
      <div class="bus-book">
        <label class="bus-check"><input type="checkbox" id="busWanted" /> <span>{t(lang,'book_bus_label')}</span></label>
        <div class="bus-city-wrap" id="busCityWrap" style="display:none">
          <div class="bus-legs">
            <div class="bus-leg">
              <label for="busOut">{t(lang,'book_bus_out')}</label>
              <select id="busOut">
                <option value="">—</option>
                <option>Hanoi</option><option>Sapa</option><option>Ninh Binh</option><option>Cat Ba</option><option>Ha Long</option>
              </select>
            </div>
            <div class="bus-leg">
              <label for="busRet">{t(lang,'book_bus_ret')}</label>
              <select id="busRet">
                <option value="">—</option>
                <option>Hanoi</option><option>Sapa</option><option>Ninh Binh</option><option>Cat Ba</option><option>Ha Long</option>
              </select>
            </div>
          </div>
        </div>
        <p class="bus-warn">⚠ {t(lang,'book_bus_note')}</p>
        <a class="bus-link" href={`/${lang}/bus`}>{t(lang,'book_bus_see')} →</a>
      </div>
    </div>

    <aside>
      <div class="quote">
        <div class="lbl">{t(lang,'q_live')}</div>
        <div class="big" id="qbig">$0</div>
        <div class="q-cur" id="qcur"></div>
        <div class="line"></div>
        <div class="q-sum" id="qsum"></div>
        <div class="line"></div>
        <p class="note">{t(lang,'q_note')}</p>
        <div class="q-bus-excl">{t(lang,'q_bus_excl')}</div>
        <button class="btn btn-rust btn-block cta" id="submitBtn" type="button">{t(lang,'book_cta')}</button>
        <div class="formmsg" id="formmsg"></div>
      </div>
    </aside>
  </div>

  <div id="okOverlay" class="ok-overlay hidden">
    <div class="ok-modal">
      <div class="ok-check">✓</div>
      <h3>{t(lang,'ok_title')}</h3>
      <p>{t(lang,'ok_msg')}</p>
      <button type="button" class="btn btn-rust" id="okClose">{t(lang,'ok_close')}</button>
    </div>
  </div>

  <div id="rentalOverlay" class="ok-overlay hidden">
    <div class="rental-modal">
      <button class="rm-close" id="rentalClose" type="button" aria-label="Close">×</button>
      <img src="/rental-rates.jpg" alt="Tien Tour motorbike rental daily rates" />
      <p class="rm-note">{t(lang,'rental_note')}</p>
      <a class="btn btn-rust btn-block" href="https://wa.me/84865246989" target="_blank" rel="noopener">{t(lang,'rental_book')}</a>
    </div>
  </div>

  <script define:vars={{ T, L }}>
    // ---- Grille tarifaire (VND en milliers, USD exact) — source: doc Tien Tour, 1$ = 26 000 VND ----
    const PRICES = {
      2: { easy_rider:{dorm:{vnd:2700,usd:100}, private:{vnd:2900,usd:110}}, self_driving:{dorm:{vnd:2300,usd:88}, private:{vnd:2500,usd:96}}, on_the_back:{dorm:{vnd:1700,usd:65}, private:{vnd:1900,usd:73}} },
      3: { easy_rider:{dorm:{vnd:3360,usd:129}, private:{vnd:3680,usd:140}}, self_driving:{dorm:{vnd:2950,usd:113}, private:{vnd:3300,usd:127}}, on_the_back:{dorm:{vnd:2350,usd:90}, private:{vnd:2650,usd:102}} },
      4: { easy_rider:{dorm:{vnd:4500,usd:173}, private:{vnd:4800,usd:185}}, self_driving:{dorm:{vnd:3950,usd:152}, private:{vnd:4460,usd:172}}, on_the_back:{dorm:{vnd:3350,usd:129}, private:{vnd:3850,usd:148}} },
    };
    const FX = { usdToEur: 0.92 }; // taux indicatif pour l'affichage EUR (ajustable)
    const fmtVND = (n)=> Math.round(n).toLocaleString('en-US').replace(/,/g,'\u00a0') + '\u00a0VND';
    const state = { opt:'easy_rider', slug:T[0].slug, travelers:2, backPax:0, rooms:0, beds:2 };
    const selTour = ()=> T.find(t=>t.slug===state.slug) || T[0];
    function compute(){
      const tr=selTour(), days=tr.days, P=PRICES[days] || PRICES[2];
      const pax=state.travelers, back = state.opt==='self_drive' ? state.backPax : 0;
      const mainRole = state.opt==='easy_rider' ? 'easy_rider' : 'self_driving';
      const people = pax + back;
      // hébergement : rooms personnes en privé, beds personnes en dortoir (rooms+beds = people)
      const priv = Math.min(state.rooms, people), dorm = people - priv;
      // on affecte le privé d'abord aux voyageurs principaux, puis aux passagers arrière
      const privMain = Math.min(priv, pax), privBack = priv - privMain;
      const dormMain = pax - privMain, dormBack = back - privBack;
      let vnd=0, usd=0;
      const add=(n,role,acc)=>{ if(n>0){ vnd += n*P[role][acc].vnd; usd += n*P[role][acc].usd; } };
      add(privMain, mainRole, 'private'); add(dormMain, mainRole, 'dorm');
      add(privBack, 'on_the_back', 'private'); add(dormBack, 'on_the_back', 'dorm');
      return { days, pax, back, people, priv, dorm, vnd: vnd*1000, usd };
    }
    function render(){
      const r=compute();
      document.getElementById('qbig').textContent = fmtVND(r.vnd);
      const eur=Math.round(r.usd*FX.usdToEur);
      document.getElementById('qcur').innerHTML = `≈ $${r.usd.toLocaleString('en-US')} · ≈ €${eur.toLocaleString('en-US')}`;
      const rows=[];
      rows.push(['Tour', `<b>${selTour().title}</b>`]);
      let paxTxt = `<b>${r.people}</b> ${L.pax}`;
      if(r.back>0) paxTxt += ` <small>(${L.inclBack} <b>${r.back}</b> ${L.backLabel.toLowerCase()})</small>`;
      rows.push([L.travelers.charAt(0).toUpperCase()+L.travelers.slice(1), paxTxt]);
      const acc=[];
      if(r.priv>0) acc.push(`<b>${r.priv}</b> ${L.accomPrivate.toLowerCase()}`);
      if(r.dorm>0) acc.push(`<b>${r.dorm}</b> ${L.accomDorm.toLowerCase()}`);
      rows.push([L.accomTitle, acc.length?acc.join(' · '):'—']);
      const busOn=document.getElementById('busWanted').checked;
      const bo=document.getElementById('busOut').value, br=document.getElementById('busRet').value;
      if(busOn && (bo||br)) rows.push(['Bus', `<b>${bo||'?'}</b> → Ha Giang · Ha Giang → <b>${br||'?'}</b> <small>(${L.busShort})</small>`]);
      document.getElementById('qsum').innerHTML = rows.map(([k,v])=>`<div class="qs-row"><span class="qs-k">${k}</span><span class="qs-v">${v}</span></div>`).join('');
    }
    const backpaxEl = document.getElementById('backpax');
    const MAX_GROUP = 10; // voyageurs max (easy riders non comptés)
    const backMax = ()=> Math.min(state.travelers, MAX_GROUP - state.travelers);
    function syncBack(){
      if(state.backPax>backMax()) state.backPax=Math.max(0,backMax());
      document.getElementById('bval').textContent=state.backPax;
      document.getElementById('bpHint').textContent = `${L.backHint} (${Math.max(0,backMax())})`;
    }
    function refreshOptUI(){
      backpaxEl.style.display = state.opt==='self_drive' ? '' : 'none';
      if(state.opt!=='self_drive'){ state.backPax=0; document.getElementById('bval').textContent=0; }
      else syncBack();
      syncRooms();
    }
    const peopleCount = ()=> state.travelers + (state.opt==='self_drive' ? state.backPax : 0);
    function syncRooms(){
      const max=peopleCount();
      if(state.rooms<0) state.rooms=0; if(state.rooms>max) state.rooms=max;
      state.beds = max - state.rooms;               // chaque personne a un couchage : rooms + beds = personnes
      document.getElementById('rval').textContent=state.rooms;
      document.getElementById('dval').textContent=state.beds;
      document.getElementById('roomsHint').textContent = `${L.accomHint} ${max}`;
      document.getElementById('bedsHint').textContent  = `${L.accomHint} ${max}`;
    }
    document.getElementById('rmin').addEventListener('click',()=>{ state.rooms=Math.max(0,state.rooms-1); syncRooms(); render(); });
    document.getElementById('rplus').addEventListener('click',()=>{ state.rooms=Math.min(peopleCount(),state.rooms+1); syncRooms(); render(); });
    document.getElementById('dmin').addEventListener('click',()=>{ state.rooms=Math.min(peopleCount(),state.rooms+1); syncRooms(); render(); });   // − dorm bed = + private room
    document.getElementById('dplus').addEventListener('click',()=>{ state.rooms=Math.max(0,state.rooms-1); syncRooms(); render(); });               // + dorm bed = − private room
    document.querySelectorAll('.opt').forEach(el=>el.addEventListener('click',()=>{
      state.opt=el.dataset.opt; document.querySelectorAll('.opt').forEach(x=>x.classList.remove('sel')); el.classList.add('sel'); refreshOptUI(); render();
    }));
    document.querySelectorAll('.tour-opt').forEach(el=>el.addEventListener('click',()=>{
      state.slug=el.dataset.slug; document.querySelectorAll('.tour-opt').forEach(x=>x.classList.remove('sel')); el.classList.add('sel'); render();
    }));
    document.getElementById('tmin').addEventListener('click',()=>{ state.travelers=Math.max(1,state.travelers-1); document.getElementById('tval').textContent=state.travelers; syncBack(); syncRooms(); render(); });
    document.getElementById('tplus').addEventListener('click',()=>{ state.travelers=Math.min(MAX_GROUP,state.travelers+1); document.getElementById('tval').textContent=state.travelers; syncBack(); syncRooms(); render(); });
    document.getElementById('bmin').addEventListener('click',()=>{ state.backPax=Math.max(0,state.backPax-1); document.getElementById('bval').textContent=state.backPax; syncRooms(); render(); });
    document.getElementById('bplus').addEventListener('click',()=>{ state.backPax=Math.min(backMax(),state.backPax+1); document.getElementById('bval').textContent=state.backPax; syncRooms(); render(); });
    document.getElementById('busWanted').addEventListener('change',(e)=>{ document.getElementById('busCityWrap').style.display = e.target.checked ? '' : 'none'; render(); });
    document.getElementById('busOut').addEventListener('change',render);
    document.getElementById('busRet').addEventListener('change',render);

    const val=(id)=>(document.getElementById(id)?.value||'').trim();
    const msgEl=document.getElementById('formmsg');
    const showMsg=(cls,text)=>{ msgEl.className='formmsg '+cls; msgEl.textContent=text; };
    document.getElementById('submitBtn').addEventListener('click', async ()=>{
      const name=val('f_name'), email=val('f_email'), whatsapp=val('f_whatsapp');
      if(!name || (!email && !whatsapp)){ showMsg('err',L.errContact); return; }
      const r=compute(), tr=selTour(), btn=document.getElementById('submitBtn');
      btn.disabled=true; const old=btn.textContent; btn.textContent='…';
      try{
        const resp=await fetch('/api/book',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({ name,email,whatsapp, date:val('f_date'), message:val('f_message'),
            tour_slug:tr.slug, tour_title:tr.title, option:state.opt, travelers:r.people, back_pax:r.back, days:r.days,
            amount:r.vnd, bus_booking:document.getElementById('busWanted').checked, bus_out:(document.getElementById('busOut')?.value||''), bus_return:(document.getElementById('busRet')?.value||''),
            accommodation:(state.rooms>0&&state.beds>0?'mixed':(state.beds>0?'dorm':'private')), rooms:state.rooms, dorm_beds:state.beds,
            country:val('f_country'),
            language:L.lang, source:'book_page' })});
        const data=await resp.json().catch(()=>({}));
        if(resp.ok && data.ok){ document.getElementById('okOverlay').classList.remove('hidden');
          ['f_name','f_email','f_whatsapp','f_date','f_country','f_message'].forEach(i=>{const e=document.getElementById(i); if(e) e.value='';});
        } else { const code = data && data.error ? data.error : ('HTTP '+resp.status); const det = data && data.detail ? (' — '+String(data.detail).slice(0,160)) : ''; console.error('Booking failed:', resp.status, data); showMsg('err', L.errMsg+' ['+code+det+']'); }
      }catch(e){ console.error('Booking exception:', e); showMsg('err', L.errMsg+' [network]'); }
      btn.disabled=false; btn.textContent=old;
    });
    const okOv=document.getElementById('okOverlay');
    document.getElementById('okClose').addEventListener('click',()=>okOv.classList.add('hidden'));
    okOv.addEventListener('click',(e)=>{ if(e.target===okOv) okOv.classList.add('hidden'); });
    const rentOv=document.getElementById('rentalOverlay');
    document.getElementById('rentalCard').addEventListener('click',()=>rentOv.classList.remove('hidden'));
    document.getElementById('rentalClose').addEventListener('click',()=>rentOv.classList.add('hidden'));
    rentOv.addEventListener('click',(e)=>{ if(e.target===rentOv) rentOv.classList.add('hidden'); });
    syncRooms();
    render();
  </script>
</Base>
