---
import { getCollection } from 'astro:content';
import { LANGS, t } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){ return LANGS.map((lang)=>({ params:{ lang }})); }
const { lang } = Astro.params;
const tours = (await getCollection('tours')).sort((a,b)=>a.data.order-b.data.order);
const T = tours.map((tr)=>({ slug:tr.slug, price:tr.data.priceFrom, days:tr.data.durationDays, route:tr.data.route||'', image:tr.data.image||'', title:(tr.data[lang]??tr.data.en).title }));
const opts = [
  ['easy_rider','opt_er_t','opt_er_b','opt_er_d'],
  ['self_drive','opt_sd_t','opt_sd_b','opt_sd_d'],
  ['private','opt_pt_t','opt_pt_b','opt_pt_d'],
].map(([k,a,b,c])=>({ key:k, title:t(lang,a), badge:t(lang,b), desc:t(lang,c) }));
const L = {
  lang, for:t(lang,'q_for'), travelers:t(lang,'q_travelers'), days:t(lang,'days'),
  insurance:t(lang,'q_insurance'), total:t(lang,'q_total'),
  erSurcharge:`${t(lang,'opt_er_t')} ${t(lang,'q_surcharge')}`,
  carLabel:`${t(lang,'opt_pc_t')} (+50%)`, bikeLabel:`${t(lang,'opt_pb_t')} (+40%)`,
  backLabel:t(lang,'book_back'), backHint:t(lang,'book_back_hint'),
  accomHint:t(lang,'accom_hint'), accomDorm:t(lang,'accom_dorm'),
  accomTitle:t(lang,'accom_title'), accomPrivate:t(lang,'accom_private'),
  inclBack:t(lang,'q_incl_back'), busShort:t(lang,'q_bus_short'), pax:t(lang,'q_pax'),
  dietTitle:t(lang,'diet_title'), dietVeg:t(lang,'diet_veg'), dietVegan:t(lang,'diet_vegan'), dietSum:t(lang,'diet_sum'),
  people: lang==='fr' ? 'pers' : 'people',
  optEr:t(lang,'opt_er_t'), optSd:t(lang,'opt_sd_t'), optPt:t(lang,'opt_pt_t'),
  lblTourRate: lang==='fr' ? 'Tarif circuit' : 'Tour rate',
  lblPrivRoom: lang==='fr' ? 'Chambre privée' : 'Private room',
  lblPrivTour: lang==='fr' ? 'Supplément tour privé' : 'Private tour',
    insTitle: lang==='fr' ? 'Assurance' : 'Insurance',
    insBasic: lang==='fr' ? 'Assurance de base' : 'Basic insurance',
    insInc:   lang==='fr' ? 'incluse' : 'included',
    insPrem:  lang==='fr' ? 'Assurance premium' : 'Premium insurance',
    insPremHint: lang==='fr' ? '500 000 VND / pers' : '500,000 VND / pax',
    roomCap:  lang==='fr' ? 'jusqu\u2019à 2 pers / chambre' : 'up to 2 people / room',
    bedCap:   lang==='fr' ? '1 pers / lit' : '1 person / bed',
  cta:t(lang,'book_cta'), okMsg:t(lang,'ok_msg'), errMsg:t(lang,'err_msg'), errContact:t(lang,'err_contact'),
};
const seoMap = {
  en:{ t:"Book Your Ha Giang Loop Tour — Live Quote | Tien Tour", d:"Build your Ha Giang adventure and get a live quote. No payment until we confirm availability." },
  fr:{ t:"Réserver votre boucle de Ha Giang — devis en direct | Tien Tour", d:"Composez votre aventure à Ha Giang et obtenez un devis en direct. Aucun paiement avant confirmation des disponibilités." },
  vi:{ t:"Đặt tour cung đường Hà Giang — báo giá trực tiếp | Tien Tour", d:"Thiết kế hành trình Hà Giang và nhận báo giá trực tiếp. Chưa thanh toán cho đến khi xác nhận lịch trống." },
};
const seo = seoMap[lang] ?? seoMap.en;
---
<Base title={seo.t} description={seo.d} lang={lang}>
  <section class="book-hero"><div class="wrap">
    <div class="eyebrow">{t(lang,'book_eyebrow')}</div>
    <h1>{t(lang,'book_title')}</h1>
    <p>{t(lang,'book_sub')}</p>
  </div></section>

  <div class="wrap book-grid">
    <div>
      <div class="step-h"><span class="n italic">01</span><h2>{t(lang,'book_s1')}</h2></div>
      <div class="opts">
        {opts.map((o,i)=>(
          <div class={"opt"+(i===0?" sel":"")} data-opt={o.key}>
            <div class="t"><h3>{o.title}</h3><span class="badge">{o.badge}</span></div>
            <p>{o.desc}</p>
          </div>
        ))}
      </div>

      <div class="step-h"><span class="n italic">02</span><h2>{t(lang,'book_s2')}</h2></div>
      <div id="tourlist">
        {T.map((tr,i)=>(
          <div class={"tour-opt"+(i===0?" sel":"")} data-slug={tr.slug} data-price={tr.price} data-days={tr.days}>
            <div class="th">{tr.image && <img src={tr.image} alt={tr.title} loading="lazy" />}</div>
            <div><h3>{tr.title}</h3>
              <div class="meta">{tr.days} {t(lang,'days')} · {t(lang,'from')} {tr.price.toLocaleString('en-US').replace(/,/g,'\u00a0')} VND/pers.</div>
              {tr.route && <div class="route">{tr.route}</div>}
            </div>
          </div>
        ))}
      </div>
      <div class="form" style="margin-top:14px">
        <div class="field"><label for="f_date">{t(lang,'f_date')}</label><input id="f_date" type="date" /></div>
      </div>

      <div class="step-h"><span class="n italic">03</span><h2>{t(lang,'book_travelers')}</h2></div>
      <div class="travelers">
        <button id="tmin" type="button" aria-label="-">−</button>
        <span class="v" id="tval">1</span>
        <button id="tplus" type="button" aria-label="+">+</button>
      </div>
      <div class="backpax" id="backpax" style="display:none">
        <div class="bp-label">{t(lang,'book_back')} <small id="bpHint">{t(lang,'book_back_hint')}</small></div>
        <div class="travelers">
          <button id="bmin" type="button" aria-label="-">−</button>
          <span class="v" id="bval">0</span>
          <button id="bplus" type="button" aria-label="+">+</button>
        </div>
      </div>

      <div class="accom">
        <div class="ac-title">{t(lang,'accom_title')}</div>
        <div class="ac-row">
          <div class="ac-lbl">{t(lang,'accom_private')} <small id="roomsHint"></small></div>
          <div class="travelers sm">
            <button id="rmin" type="button" aria-label="-">−</button>
            <span class="v" id="rval">0</span>
            <button id="rplus" type="button" aria-label="+">+</button>
          </div>
        </div>
        <div class="ac-row">
          <div class="ac-lbl">{t(lang,'accom_dorm')} <small id="bedsHint"></small></div>
          <div class="travelers sm">
            <button id="dmin" type="button" aria-label="-">−</button>
            <span class="v" id="dval">1</span>
            <button id="dplus" type="button" aria-label="+">+</button>
          </div>
        </div>
      </div>

      <div class="accom" id="diet">
        <div class="ac-title">{t(lang,'diet_title')}</div>
        <div class="ac-row">
          <div class="ac-lbl">{t(lang,'diet_veg')} <small id="vegHint"></small></div>
          <div class="travelers sm">
            <button id="vgmin" type="button" aria-label="-">−</button>
            <span class="v" id="vgval">0</span>
            <button id="vgplus" type="button" aria-label="+">+</button>
          </div>
        </div>
        <div class="ac-row">
          <div class="ac-lbl">{t(lang,'diet_vegan')} <small id="veganHint"></small></div>
          <div class="travelers sm">
            <button id="vnmin" type="button" aria-label="-">−</button>
            <span class="v" id="vnval">0</span>
            <button id="vnplus" type="button" aria-label="+">+</button>
          </div>
        </div>
      </div>

      <div class="accom" id="insurance">
        <div class="ac-title">{lang==='fr'?'Assurance':'Insurance'}</div>
        <div class="ac-row">
          <div class="ac-lbl">{lang==='fr'?'Assurance de base':'Basic insurance'} <small>({lang==='fr'?'incluse':'included'})</small></div>
          <div style="color:#2F6E58;font-weight:700;font-size:18px">✓</div>
        </div>
        <div class="ac-row">
          <div class="ac-lbl">{lang==='fr'?'Assurance premium':'Premium insurance'} <small>{lang==='fr'?'500 000 VND / pers':'500,000 VND / pax'}</small></div>
          <div class="travelers sm">
            <button id="pmin" type="button" aria-label="-">−</button>
            <span class="v" id="pval">0</span>
            <button id="pplus" type="button" aria-label="+">+</button>
          </div>
        </div>
      </div>

      <div class="step-h"><span class="n italic">04</span><h2>{t(lang,'book_s4')}</h2></div>
      <div class="form">
        <div class="field"><label for="f_name">{t(lang,'f_name')}</label><input id="f_name" type="text" autocomplete="name" /></div>
        <div class="row2">
          <div class="field"><label for="f_email">{t(lang,'f_email')}</label><input id="f_email" type="email" autocomplete="email" /></div>
          <div class="field"><label for="f_whatsapp">{t(lang,'f_whatsapp')}</label><input id="f_whatsapp" type="tel" /></div>
        </div>
        <div class="field"><label for="f_country">{t(lang,'f_country')}</label><input id="f_country" type="text" autocomplete="country-name" /></div>
        <div class="field"><label for="f_message">{t(lang,'f_message')}</label><textarea id="f_message"></textarea></div>
      </div>

      <div class="step-h"><span class="n italic">05</span><h2>{t(lang,'book_bus_title')}</h2></div>
      <div class="bus-book">
        <label class="bus-check"><input type="checkbox" id="busWanted" /> <span>{t(lang,'book_bus_label')}</span></label>
        <div class="bus-city-wrap" id="busCityWrap" style="display:none">
          <div class="bus-legs">
            <div class="bus-leg">
              <label for="busOut">{t(lang,'book_bus_out')}</label>
              <select id="busOut">
                <option value="">—</option>
                <option>Hanoi</option><option>Sapa</option><option>Ninh Binh</option><option>Cat Ba</option><option>Ha Long</option>
              </select>
            </div>
            <div class="bus-leg">
              <label for="busRet">{t(lang,'book_bus_ret')}</label>
              <select id="busRet">
                <option value="">—</option>
                <option>Hanoi</option><option>Sapa</option><option>Ninh Binh</option><option>Cat Ba</option><option>Ha Long</option>
              </select>
            </div>
          </div>
        </div>
        <p class="bus-warn">⚠ {t(lang,'book_bus_note')}</p>
        <a class="bus-link" href={`/${lang}/bus`}>{t(lang,'book_bus_see')} →</a>
      </div>
    </div>

    <aside>
      <div class="quote">
        <div class="lbl">{t(lang,'q_live')}</div>
        <div class="big" id="qbig">$0</div>
        <div class="q-cur" id="qcur"></div>
        <div class="line"></div>
        <div class="q-sum" id="qsum"></div>
        <div class="line"></div>
        <p class="note">{t(lang,'q_note')}</p>
        <div class="q-bus-excl">{t(lang,'q_bus_excl')}</div>
        <button class="btn btn-rust btn-block cta" id="submitBtn" type="button">{t(lang,'book_cta')}</button>
        <div class="formmsg" id="formmsg"></div>
      </div>
    </aside>
  </div>

  <div id="okOverlay" class="ok-overlay hidden">
    <div class="ok-modal">
      <div class="ok-check">✓</div>
      <h3>{t(lang,'ok_title')}</h3>
      <p>{t(lang,'ok_msg')}</p>
      <button type="button" class="btn btn-rust" id="okClose">{t(lang,'ok_close')}</button>
    </div>
  </div>


  <script define:vars={{ T, L }}>
    // ---- Grille tarifaire (VND en milliers, USD exact) — source: doc Tien Tour, 1$ = 26 000 VND ----
    const PRICES = {
      2: { easy_rider:{dorm:{vnd:2700,usd:100}, private:{vnd:2900,usd:110}}, self_driving:{dorm:{vnd:2300,usd:88}, private:{vnd:2500,usd:96}}, on_the_back:{dorm:{vnd:1700,usd:65}, private:{vnd:1900,usd:73}} },
      3: { easy_rider:{dorm:{vnd:3360,usd:129}, private:{vnd:3680,usd:140}}, self_driving:{dorm:{vnd:2950,usd:113}, private:{vnd:3300,usd:127}}, on_the_back:{dorm:{vnd:2350,usd:90}, private:{vnd:2650,usd:102}} },
      4: { easy_rider:{dorm:{vnd:4500,usd:173}, private:{vnd:4800,usd:185}}, self_driving:{dorm:{vnd:3950,usd:152}, private:{vnd:4460,usd:172}}, on_the_back:{dorm:{vnd:3350,usd:129}, private:{vnd:3850,usd:148}} },
    };
    const FX = { usdToEur: 0.92 }; // taux indicatif pour l'affichage EUR (ajustable)
    const fmtVND = (n)=> Math.round(n).toLocaleString('en-US').replace(/,/g,'\u00a0') + '\u00a0VND';
    const state = { opt:'easy_rider', slug:T[0].slug, travelers:1, backPax:0, rooms:0, beds:1, veg:0, vegan:0, premium:0 };
    const selTour = ()=> T.find(t=>t.slug===state.slug) || T[0];
    // Tour privé : supplément +780 000 VND / personne (≈ 30 $, base 26 000 VND/$).
    // baseRole = tarif de référence du tour (par personne, selon chambre privée / lit dortoir).
    // Passer baseRole à 'self_driving' si le tour privé doit partir du tarif self-drive.
    const PRIVATE_TOUR = { surchargeVnd: 780, surchargeUsd: 30, baseRole: 'easy_rider' };
    const PREMIUM = { vndK: 500, usd: 19 }; // assurance premium : 500 000 VND / pax (≈ 19 $)
    function compute(){
      const tr=selTour(), days=tr.days, P=PRICES[days] || PRICES[2];
      const pax=state.travelers, back = state.opt==='self_drive' ? state.backPax : 0;
      const mainRole = state.opt==='self_drive' ? 'self_driving'
                     : state.opt==='private'    ? PRIVATE_TOUR.baseRole
                     : 'easy_rider';
      const people = pax + back;
      // hébergement : lits dortoir = personnes en dortoir ; le reste dort en chambre privée (2 pers max/chambre)
      const dorm = Math.min(state.beds, people), privPeople = people - dorm;
      const rooms = privPeople>0 ? Math.min(Math.max(state.rooms, Math.ceil(privPeople/2)), privPeople) : 0;
      let vnd=0, usd=0;
      // base : tout le monde au tarif dortoir (selon le rôle)
      const baseVndK = pax*P[mainRole].dorm.vnd + back*P['on_the_back'].dorm.vnd;
      const baseUsd  = pax*P[mainRole].dorm.usd + back*P['on_the_back'].dorm.usd;
      vnd += baseVndK; usd += baseUsd;
      // supplément chambre privée : PAR CHAMBRE (une chambre accueille jusqu'à 2 personnes)
      const suppVndK = P[mainRole].private.vnd - P[mainRole].dorm.vnd;
      const suppUsd  = P[mainRole].private.usd - P[mainRole].dorm.usd;
      vnd += rooms*suppVndK; usd += rooms*suppUsd;
      // Tour privé : supplément par personne
      if(state.opt==='private'){ vnd += people*PRIVATE_TOUR.surchargeVnd; usd += people*PRIVATE_TOUR.surchargeUsd; }
      // Assurance premium : 500 000 VND / pax choisis (le reste = assurance de base, incluse)
      const premCount = Math.max(0, Math.min(state.premium, people));
      if(premCount>0){ vnd += premCount*PREMIUM.vndK; usd += premCount*PREMIUM.usd; }
      const privTour = state.opt==='private' ? people*PRIVATE_TOUR.surchargeVnd : 0;
      return { days, pax, back, people, priv:privPeople, dorm, rooms, vnd: vnd*1000, usd, baseVnd: baseVndK*1000, privSuppVnd: rooms*suppVndK*1000, surchargeVnd: privTour*1000, premCount, premVnd: premCount*PREMIUM.vndK*1000, mainRole };
    }
    function render(){
      const r=compute();
      document.getElementById('qbig').textContent = fmtVND(r.vnd);
      const eur=Math.round(r.usd*FX.usdToEur);
      document.getElementById('qcur').innerHTML = `≈ $${r.usd.toLocaleString('en-US')} · ≈ €${eur.toLocaleString('en-US')}`;
      const rows=[];
      rows.push(['Tour', `<b>${selTour().title}</b>`]);
      const _dv=document.getElementById('f_date')?.value;
      if(_dv){ const sd=new Date(_dv+'T00:00:00'), ed=new Date(sd); ed.setDate(ed.getDate()+(r.days-1));
        const _f=(d)=>d.toLocaleDateString(L.lang==='fr'?'fr-FR':'en-GB',{day:'numeric',month:'short',year:'numeric'});
        rows.push([L.lang==='fr'?'Dates':'Dates', `<b>${_f(sd)}</b> → <b>${_f(ed)}</b>`]); }
      let paxTxt = `<b>${r.people}</b> ${L.pax}`;
      if(r.back>0) paxTxt += ` <small>(${L.inclBack} <b>${r.back}</b> ${L.backLabel.toLowerCase()})</small>`;
      rows.push([L.travelers.charAt(0).toUpperCase()+L.travelers.slice(1), paxTxt]);
      const acc=[];
      if(r.rooms>0) acc.push(`<b>${r.rooms}</b> ${L.accomPrivate.toLowerCase()}`);
      if(r.dorm>0) acc.push(`<b>${r.dorm}</b> ${L.accomDorm.toLowerCase()}`);
      rows.push([L.accomTitle, acc.length?acc.join(' · '):'—']);
      rows.push([L.insTitle, `${L.insBasic} ${L.insInc}`]);
      const diet=[];
      if(state.veg>0)   diet.push(`<b>${state.veg}</b> ${L.dietVeg.toLowerCase()}`);
      if(state.vegan>0) diet.push(`<b>${state.vegan}</b> ${L.dietVegan.toLowerCase()}`);
      if(diet.length) rows.push([L.dietSum, diet.join(' · ')]);
      const busOn=document.getElementById('busWanted').checked;
      const bo=document.getElementById('busOut').value, br=document.getElementById('busRet').value;
      if(busOn && (bo||br)) rows.push(['Bus', `<b>${bo||'?'}</b> → Ha Giang · Ha Giang → <b>${br||'?'}</b> <small>(${L.busShort})</small>`]);
      const sumHtml = rows.map(([k,v])=>`<div class="qs-row"><span class="qs-k">${k}</span><span class="qs-v">${v}</span></div>`).join('');
      const optName = state.opt==='self_drive' ? L.optSd : state.opt==='private' ? L.optPt : L.optEr;
      const pr=[];
      pr.push([`${optName} <small>× ${r.people}</small>`, fmtVND(r.baseVnd)]);
      if(r.rooms>0) pr.push([`${L.lblPrivRoom} <small>× ${r.rooms}</small>`, '+ '+fmtVND(r.privSuppVnd)]);
      if(state.opt==='private' && r.surchargeVnd>0) pr.push([L.lblPrivTour, '+ '+fmtVND(r.surchargeVnd)]);
      if(r.premCount>0) pr.push([`${L.insPrem} <small>× ${r.premCount}</small>`, '+ '+fmtVND(r.premVnd)]);
      const prHtml = pr.map(([k,v])=>`<div class="qs-row qs-price"><span class="qs-k">${k}</span><span class="qs-v">${v}</span></div>`).join('');
      document.getElementById('qsum').innerHTML = sumHtml + '<div class="qs-div"></div>' + prHtml;
    }
    const backpaxEl = document.getElementById('backpax');
    const MAX_GROUP = 10; // voyageurs max (easy riders non comptés)
    const backMax = ()=> Math.min(state.travelers, MAX_GROUP - state.travelers);
    function syncBack(){
      if(state.backPax>backMax()) state.backPax=Math.max(0,backMax());
      document.getElementById('bval').textContent=state.backPax;
      document.getElementById('bpHint').textContent = `${L.backHint} (${Math.max(0,backMax())})`;
    }
    function refreshOptUI(){
      backpaxEl.style.display = state.opt==='self_drive' ? '' : 'none';
      if(state.opt!=='self_drive'){ state.backPax=0; document.getElementById('bval').textContent=0; }
      else syncBack();
      syncRooms(); syncDiet(); syncPremium();
    }
    const peopleCount = ()=> state.travelers + (state.opt==='self_drive' ? state.backPax : 0);
    function syncRooms(){
      const max=peopleCount();
      if(state.beds<0) state.beds=0; if(state.beds>max) state.beds=max;
      const pp = max - state.beds;                       // personnes en chambre privée
      const rlo = pp>0 ? Math.ceil(pp/2) : 0;            // min chambres (2 pers/chambre max)
      if(state.rooms<rlo) state.rooms=rlo;
      if(state.rooms>pp) state.rooms=pp;
      document.getElementById('rval').textContent=state.rooms;
      document.getElementById('dval').textContent=state.beds;
      document.getElementById('roomsHint').textContent = L.roomCap;
      document.getElementById('bedsHint').textContent  = L.bedCap;
    }
    document.getElementById('rmin').addEventListener('click',()=>{   // − chambre privée (plus de partage)
      const pp=peopleCount()-state.beds, lo=pp>0?Math.ceil(pp/2):0;
      state.rooms=Math.max(lo,state.rooms-1); syncRooms(); render(); });
    document.getElementById('rplus').addEventListener('click',()=>{  // + chambre privée (moins de partage)
      const pp=peopleCount()-state.beds;
      state.rooms=Math.min(pp,state.rooms+1); syncRooms(); render(); });
    document.getElementById('dmin').addEventListener('click',()=>{   // − lit dortoir → + en chambre privée
      state.beds=Math.max(0,state.beds-1); syncRooms(); render(); });
    document.getElementById('dplus').addEventListener('click',()=>{  // + lit dortoir → − en chambre privée
      state.beds=Math.min(peopleCount(),state.beds+1); syncRooms(); render(); });
    // régime alimentaire : nb. de végétariens + nb. de végans ≤ nb. total de personnes
    function syncDiet(){
      const max=peopleCount();
      state.veg   = Math.max(0, Math.min(state.veg, max));
      state.vegan = Math.max(0, Math.min(state.vegan, max - state.veg)); // veg + vegan ≤ personnes
      document.getElementById('vgval').textContent=state.veg;
      document.getElementById('vnval').textContent=state.vegan;
      document.getElementById('vegHint').textContent   = `${L.accomHint} ${Math.max(0, max - state.vegan)}`;
      document.getElementById('veganHint').textContent = `${L.accomHint} ${Math.max(0, max - state.veg)}`;
    }
    document.getElementById('vgmin').addEventListener('click',()=>{ state.veg=Math.max(0,state.veg-1); syncDiet(); syncPremium(); render(); });
    document.getElementById('vgplus').addEventListener('click',()=>{ if(state.veg+state.vegan<peopleCount()) state.veg++; syncDiet(); syncPremium(); render(); });
    document.getElementById('vnmin').addEventListener('click',()=>{ state.vegan=Math.max(0,state.vegan-1); syncDiet(); syncPremium(); render(); });
    document.getElementById('vnplus').addEventListener('click',()=>{ if(state.veg+state.vegan<peopleCount()) state.vegan++; syncDiet(); syncPremium(); render(); });
    function syncPremium(){
      state.premium=Math.max(0,Math.min(state.premium,peopleCount()));
      document.getElementById('pval').textContent=state.premium;
    }
    document.getElementById('pmin').addEventListener('click',()=>{ state.premium=Math.max(0,state.premium-1); syncPremium(); render(); });
    document.getElementById('pplus').addEventListener('click',()=>{ state.premium=Math.min(peopleCount(),state.premium+1); syncPremium(); render(); });
    document.querySelectorAll('.opt').forEach(el=>el.addEventListener('click',()=>{
      state.opt=el.dataset.opt; document.querySelectorAll('.opt').forEach(x=>x.classList.remove('sel')); el.classList.add('sel'); refreshOptUI(); render();
    }));
    document.querySelectorAll('.tour-opt').forEach(el=>el.addEventListener('click',()=>{
      state.slug=el.dataset.slug; document.querySelectorAll('.tour-opt').forEach(x=>x.classList.remove('sel')); el.classList.add('sel'); render();
    }));
    document.getElementById('tmin').addEventListener('click',()=>{ state.travelers=Math.max(1,state.travelers-1); document.getElementById('tval').textContent=state.travelers; syncBack(); syncRooms(); syncDiet(); syncPremium(); render(); });
    document.getElementById('tplus').addEventListener('click',()=>{ const p0=peopleCount(); state.travelers=Math.min(MAX_GROUP,state.travelers+1); if(peopleCount()>p0) state.beds=Math.min(peopleCount(),state.beds+1); document.getElementById('tval').textContent=state.travelers; syncBack(); syncRooms(); syncDiet(); syncPremium(); render(); });
    document.getElementById('bmin').addEventListener('click',()=>{ state.backPax=Math.max(0,state.backPax-1); document.getElementById('bval').textContent=state.backPax; syncRooms(); syncDiet(); syncPremium(); render(); });
    document.getElementById('bplus').addEventListener('click',()=>{ const p0=peopleCount(); state.backPax=Math.min(backMax(),state.backPax+1); if(peopleCount()>p0) state.beds=Math.min(peopleCount(),state.beds+1); document.getElementById('bval').textContent=state.backPax; syncRooms(); syncDiet(); syncPremium(); render(); });
    document.getElementById('busWanted').addEventListener('change',(e)=>{ document.getElementById('busCityWrap').style.display = e.target.checked ? '' : 'none'; render(); });
    document.getElementById('busOut').addEventListener('change',render);
    document.getElementById('busRet').addEventListener('change',render);
    document.getElementById('f_date').addEventListener('change',render);

    const val=(id)=>(document.getElementById(id)?.value||'').trim();
    const msgEl=document.getElementById('formmsg');
    const showMsg=(cls,text)=>{ msgEl.className='formmsg '+cls; msgEl.textContent=text; };
    document.getElementById('submitBtn').addEventListener('click', async ()=>{
      const name=val('f_name'), email=val('f_email'), whatsapp=val('f_whatsapp');
      if(!name || (!email && !whatsapp)){ showMsg('err',L.errContact); return; }
      const r=compute(), tr=selTour(), btn=document.getElementById('submitBtn');
      btn.disabled=true; const old=btn.textContent; btn.textContent='…';
      try{
        const resp=await fetch('/api/book',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({ name,email,whatsapp, date:val('f_date'), message:(val('f_message')+(r.premCount>0?`\n[Premium insurance x ${r.premCount} pax]`:'')).trim(),
            tour_slug:tr.slug, tour_title:tr.title, option:state.opt, travelers:r.people, back_pax:r.back, days:r.days,
            amount:r.vnd, bus_booking:document.getElementById('busWanted').checked, bus_out:(document.getElementById('busOut')?.value||''), bus_return:(document.getElementById('busRet')?.value||''),
            accommodation:(state.rooms>0&&state.beds>0?'mixed':(state.beds>0?'dorm':'private')), rooms:state.rooms, dorm_beds:state.beds,
            veg:state.veg, vegan:state.vegan, premium:r.premCount, premium_amount:r.premVnd,
            country:val('f_country'),
            language:L.lang, source:'book_page' })});
        const data=await resp.json().catch(()=>({}));
        if(resp.ok && data.ok){ document.getElementById('okOverlay').classList.remove('hidden');
          ['f_name','f_email','f_whatsapp','f_date','f_country','f_message'].forEach(i=>{const e=document.getElementById(i); if(e) e.value='';});
        } else { const code = data && data.error ? data.error : ('HTTP '+resp.status); const det = data && data.detail ? (' — '+String(data.detail).slice(0,160)) : ''; console.error('Booking failed:', resp.status, data); showMsg('err', L.errMsg+' ['+code+det+']'); }
      }catch(e){ console.error('Booking exception:', e); showMsg('err', L.errMsg+' [network]'); }
      btn.disabled=false; btn.textContent=old;
    });
    const okOv=document.getElementById('okOverlay');
    document.getElementById('okClose').addEventListener('click',()=>okOv.classList.add('hidden'));
    okOv.addEventListener('click',(e)=>{ if(e.target===okOv) okOv.classList.add('hidden'); });
    (function(){
      const qtour=new URLSearchParams(location.search).get('tour');
      if(qtour && T.some(t=>t.slug===qtour)){
        state.slug=qtour;
        document.querySelectorAll('.tour-opt').forEach(x=>x.classList.toggle('sel', x.dataset.slug===qtour));
      }
    })();
    syncRooms();
    syncDiet();
    syncPremium();
    render();
  </script>
</Base>
