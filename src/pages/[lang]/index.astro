---
import { getCollection } from 'astro:content';
import { LANGS } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Why from '../../components/Why.astro';
import TourGrid from '../../components/TourGrid.astro';
import Rental from '../../components/Rental.astro';
import Riders from '../../components/Riders.astro';
import Reviews from '../../components/Reviews.astro';
import Guide from '../../components/Guide.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Gallery from '../../components/Gallery.astro';
export function getStaticPaths(){ return LANGS.map((lang)=>({ params:{ lang }})); }
const { lang } = Astro.params;
const tours = (await getCollection('tours')).sort((a,b)=>a.data.order-b.data.order);
const site = Astro.site?.toString().replace(/\/$/,'') ?? '';
const seoMap = {
  en:{ t:"Ha Giang Loop Tour with Local Easy Riders | Tien Tour", d:"Ride the legendary Ha Giang Loop with a trusted local team. Easy rider & self-drive motorbike tours, small groups, homestays. 5.0★ · 300+ reviews. Book direct." },
  fr:{ t:"Boucle de Ha Giang à moto avec pilotes locaux | Tien Tour", d:"Vivez la boucle de Ha Giang avec une équipe locale de confiance. Tours moto easy rider & self-drive, petits groupes, chez l'habitant. 5,0★ · 300+ avis. Réservez en direct." },
  vi:{ t:"Tour cung đường Hà Giang cùng người lái bản địa | Tien Tour", d:"Chinh phục cung đường Hà Giang huyền thoại cùng đội ngũ địa phương đáng tin cậy. Tour xe máy easy rider & tự lái, nhóm nhỏ, homestay. 5,0★ · 300+ đánh giá." },
};
const seo = seoMap[lang] ?? seoMap.en;
const faqMap = {
  en:[{q:"During the tour: what's included and what's not?",a:"Included: accommodation, easy riders & a local guide (motorbike driver), entrance fees & sightseeing tickets, filtered water (1.5L/day), all meals (breakfast, lunch, dinner), protective gear (helmet, elbow & knee pads), a FREE Ha Giang Loop T-shirt, plus a FREE night before the tour with luggage storage. Not included: bus tickets, tips for the driver and guide, travel insurance, and the border permit (260,000₫/person, paid directly to the local authority)."},
     {q:"Can I bring a suitcase or a large backpack?",a:"Yes, but we recommend traveling light. Luggage space on the motorbike is limited — a 20–30L backpack or duffel is ideal. Larger luggage can be left safely at our office/hostel: free storage, 24/7 CCTV."},
     {q:"Can I ride a motorbike without a valid license?",a:"To ride legally in Vietnam you need a valid motorcycle licence and an International Driving Permit (IDP, 1968 Vienna Convention). Without one you risk fines, rejected insurance and personal liability. Message us on WhatsApp to check."},
     {q:"How can I pay for my tour?",a:"Cash (Vietnamese Dong), credit/debit card (4% bank fee), or bank transfer (Revolut). A deposit may be required to confirm; the balance is paid on arrival before the tour."},
     {q:"What happens if it rains?",a:"The loop is beautiful in all seasons. If it rains we provide high-quality raincoats and adjust the pace to the road. Safety is always our priority."},
     {q:"What is your cancellation policy?",a:"Free cancellation up to 48 hours before the tour. Within 48 hours a fee may apply, and no refunds once the tour has started."},
     {q:"Are there ATMs along the route?",a:"They are limited outside the main towns. Withdraw enough cash in Ha Giang City before the tour — many small shops and markets don't accept cards."}],
  fr:[{q:"Pendant le tour : qu'est-ce qui est inclus ou non ?",a:"Inclus : hébergement, easy riders & guide local (chauffeur moto), droits d'entrée & billets des sites, eau filtrée (1,5 L/jour), tous les repas (petit-déjeuner, déjeuner, dîner), équipement de protection (casque, coudières, genouillères), un T-shirt Ha Giang Loop OFFERT, et une nuit OFFERTE avant le tour avec consigne à bagages. Non inclus : billets de bus, pourboires pour le chauffeur et le guide, assurance voyage, et le permis de frontière (260 000₫/pers., payé directement à l'autorité locale)."},
     {q:"Puis-je apporter une valise ou un grand sac à dos ?",a:"Oui, mais voyagez léger. L'espace bagage sur la moto est limité — un sac de 20–30 L est idéal. Les gros bagages se laissent en sécurité à notre bureau/hostel : stockage gratuit, vidéosurveillance 24h/24."},
     {q:"Puis-je conduire sans permis valide ?",a:"Pour conduire légalement au Vietnam, il faut un permis moto valide et un permis international (IDP, Convention de Vienne 1968). Sans, vous risquez amendes, refus d'assurance et responsabilité. Écrivez-nous sur WhatsApp pour vérifier."},
     {q:"Comment puis-je payer mon circuit ?",a:"Espèces (dongs), carte (frais bancaires 4 %) ou virement (Revolut). Un acompte peut être demandé pour confirmer ; le solde se règle à l'arrivée avant le départ."},
     {q:"Que se passe-t-il s'il pleut ?",a:"La boucle est magnifique en toute saison. En cas de pluie, nous fournissons des imperméables de qualité et adaptons l'allure. La sécurité reste la priorité."},
     {q:"Quelle est votre politique d'annulation ?",a:"Annulation gratuite jusqu'à 48 h avant le tour. Dans les 48 h, des frais peuvent s'appliquer, et aucun remboursement une fois le tour commencé."},
     {q:"Y a-t-il des distributeurs sur le parcours ?",a:"Ils sont limités hors des villes principales. Retirez assez d'espèces à Ha Giang City avant le tour — beaucoup de petites boutiques et marchés n'acceptent pas la carte."}],
};
const faq = faqMap[lang] ?? faqMap.en;
const jsonld = { "@context":"https://schema.org","@graph":[
  { "@type":"TravelAgency","name":"Tien Tour","areaServed":"Ha Giang, Vietnam","url":`${site}/${lang}/`,
    "aggregateRating":{"@type":"AggregateRating","ratingValue":"5.0","reviewCount":"300","bestRating":"5"} },
  { "@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}})) }
]};
---
<Base title={seo.t} description={seo.d} lang={lang} jsonld={jsonld}>
  <Hero lang={lang} />
  <Why lang={lang} />
  <TourGrid lang={lang} tours={tours} limit={3} />
  <Rental lang={lang} />
  <Riders lang={lang} />
  <Gallery lang={lang} />
  <Reviews lang={lang} />
  <Guide lang={lang} />
  <Faq lang={lang} faq={faq} />
  <FinalCta lang={lang} />
</Base>
