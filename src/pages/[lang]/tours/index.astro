---
import { getCollection } from 'astro:content';
import { LANGS, t } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';
import TourGrid from '../../../components/TourGrid.astro';
import BusSchedule from '../../../components/BusSchedule.astro';
import Includes from '../../../components/Includes.astro';
import FinalCta from '../../../components/FinalCta.astro';
export function getStaticPaths(){ return LANGS.map((lang)=>({ params:{ lang }})); }
const { lang } = Astro.params;
const tours = (await getCollection('tours')).sort((a,b)=>a.data.order-b.data.order);
const seoMap = {
  en:{ t:"Ha Giang Loop Tours — Easy Rider & Adventure | Tien Tour", d:"All our Ha Giang Loop motorbike tours: 2 to 4 days, easy rider or self-drive. Small groups, licensed local operator, 5.0★." },
  fr:{ t:"Circuits boucle de Ha Giang — easy rider & aventure | Tien Tour", d:"Tous nos circuits moto de la boucle de Ha Giang : 2 à 4 jours, easy rider ou self-drive. Petits groupes, opérateur local licencié, 5,0★." },
};
const seo = seoMap[lang] ?? seoMap.en;
---
<Base title={seo.t} description={seo.d} lang={lang}>
  <section style="padding-bottom:0"><div class="wrap">
    <div class="eyebrow">{t(lang,'tours_eyebrow')}</div>
    <h1 class="title">{t(lang,'tours_title')}</h1>
    <p class="sub">{t(lang,'tours_sub')}</p>
  </div></section>
  <TourGrid lang={lang} tours={tours} showHead={false} />

  <section style="padding-top:36px"><div class="wrap">
    <a class="pc-banner" href={`/${lang}/private-car`}>
      <div class="pc-banner-txt">
        <div class="eyebrow">{lang==='fr'?'Service privé & sur mesure':'Private & bespoke'}</div>
        <h2>{lang==='fr'?'Circuits privés en SUV & Limousine':'Private SUV & Limousine tours'}</h2>
        <p>{lang==='fr'?'Chauffeur privé, itinéraire 100% personnalisé, confort pour familles et petits groupes. Devis sur mesure.':'Private driver, fully customizable itinerary, comfort for families and small groups. Tailored quote.'}</p>
      </div>
      <span class="pc-banner-cta">{lang==='fr'?'Découvrir →':'Discover →'}</span>
    </a>
  </div></section>
  <style>
    .pc-banner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;
      background:linear-gradient(120deg,#1E3A2B,#2F6E58);color:#fff;border-radius:22px;padding:28px 32px;text-decoration:none;transition:.18s}
    .pc-banner:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(30,58,43,.28)}
    .pc-banner .eyebrow{color:#F0B24A}
    .pc-banner h2{margin:6px 0 8px;font:600 30px 'Fraunces',serif;color:#fff}
    .pc-banner p{margin:0;max-width:60ch;color:rgba(255,255,255,.85);line-height:1.5}
    .pc-banner-cta{background:var(--rust,#C2562E);color:#fff;font:600 15px 'Inter',sans-serif;padding:12px 22px;border-radius:999px;white-space:nowrap}
  </style>

  <section class="map-section"><div class="wrap">
    <div class="eyebrow">{lang==='fr'?'L\u2019itinéraire':'The route'}</div>
    <h2 class="title">{lang==='fr'?'La carte de la boucle':'The Ha Giang Loop map'}</h2>
    <p class="sub">{lang==='fr'?'Tous les temps forts que nous traversons — cols, villages, rivières et points de vue.':'Every highlight we ride through — passes, villages, rivers and viewpoints.'}</p>
    <figure class="route-map"><img src="/route-map.jpg" alt="Tien Tour Ha Giang Loop route map" width="1542" height="1255" loading="lazy" /></figure>
  </div></section>

  <Includes lang={lang} />

  <section class="bus-section"><div class="wrap">
    <div class="eyebrow">{lang==='fr'?'Y aller':'Getting there'}</div>
    <h2 class="title">{t(lang,'bus_tours_title')}</h2>
    <p class="bus-callout">🚌 {t(lang,'bus_tours_note')}</p>
    <BusSchedule lang={lang} />
  </div></section>

  <FinalCta lang={lang} />
</Base>
