        ['Travelers',esc(b.travelers)+(Number(b.back_pax)>0?' (incl. '+esc(b.back_pax)+' on the back)':'')],['Preferred date',esc(fmtDMY(b.date)||'—')],
        ['Accommodation', (((Number(b.rooms)||0)>0?('Private \u00d7'+esc(b.rooms)):'')+((Number(b.rooms)||0)>0&&(Number(b.dorm_beds)||0)>0?' \u00b7 ':'')+((Number(b.dorm_beds)||0)>0?('Dorm \u00d7'+esc(b.dorm_beds)):''))||'\u2014'],['Bus',b.bus_booking?'Requested — price not included':'No'],
        ['Channel',srcLabel(b.source)],
