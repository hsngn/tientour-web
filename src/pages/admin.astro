    $('setPwBtn').addEventListener('click',async()=>{
      const pw=$('np').value; const m=$('setPwMsg'); m.style.color='';
      if(!pw||pw.length<8){ m.textContent='Password must be at least 8 characters.'; return; }
      $('setPwBtn').disabled=true;
      try{ const r=await fetch(API+'/set-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:window.__recoveryToken,password:pw})});
        const d=await r.json().catch(()=>({}));
        if(d.ok){ $('setpw').classList.add('hidden'); show('login'); const le=$('loginErr'); le.style.color='var(--forest)'; le.textContent='Password updated. Please sign in.'; }
        else m.textContent='Link invalid or expired. Request a new reset link.';
      }catch(e){ m.textContent='Network error.'; }
      $('setPwBtn').disabled=false;
    });
    $('refresh').addEventListener('click',loadBookings);
    $('logout').addEventListener('click',logout);
    document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>setTab(t.dataset.view)));
    $('presets').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
      document.querySelectorAll('#presets button').forEach(x=>x.classList.remove('on'));b.classList.add('on');
      setPeriod(b.dataset.d);renderDash();});
    $('pFrom').addEventListener('change',()=>{period.from=$('pFrom').value;document.querySelectorAll('#presets button').forEach(x=>x.classList.remove('on'));renderDash();});
    $('pTo').addEventListener('change',()=>{period.to=$('pTo').value;document.querySelectorAll('#presets button').forEach(x=>x.classList.remove('on'));renderDash();});
    $('calPrev').addEventListener('click',()=>{cal.m--;if(cal.m<0){cal.m=11;cal.y--;}renderCal();});
    $('calNext').addEventListener('click',()=>{cal.m++;if(cal.m>11){cal.m=0;cal.y++;}renderCal();});
    $('calToday').addEventListener('click',()=>{cal.y=new Date().getFullYear();cal.m=new Date().getMonth();renderCal();});
    $('search').addEventListener('input',renderList);
    $('calGrid').addEventListener('click',e=>{const c=e.target.closest('.chip');if(c)openDetail(c.dataset.id);});
    $('listTable').addEventListener('click',e=>{const r=e.target.closest('.brow');if(r)openDetail(r.dataset.id);});
    $('mClose').addEventListener('click',closeModal);
    $('mSave').addEventListener('click',saveDetail);
    $('mStart').addEventListener('change',calcNights);
    $('mEnd').addEventListener('change',calcNights);
    $('mAmount').addEventListener('input',calcRemain);
    $('mPaid').addEventListener('input',calcRemain);
    ['fYear','fMonth','fDate','fSource','fStatus'].forEach(id=>$(id).addEventListener('change',renderList));
    $('fClear').addEventListener('click',()=>{$('search').value='';$('fYear').value='';$('fMonth').value='';$('fDate').value='';$('fSource').value='';$('fStatus').value='';fAttn=false;$('fAttn').classList.remove('on');renderList();});
    $('exportXlsx').addEventListener('click',exportXlsx);
    $('fAttn').addEventListener('click',()=>{ fAttn=!fAttn; $('fAttn').classList.toggle('on',fAttn); if(fAttn&&view!=='list')setTab('list'); else renderList(); });
    $('newRes').addEventListener('click',openCreate);
    $('cClose').addEventListener('click',closeCreate);
    $('cSave').addEventListener('click',createReservation);
    $('createOverlay').addEventListener('click',e=>{if(e.target===$('createOverlay'))closeCreate();});
    document.querySelectorAll('[data-add]').forEach(btn=>btn.addEventListener('click',()=>addCity(btn.dataset.add)));
    $('mAddNote').addEventListener('click',addNote);
    $('overlay').addEventListener('click',e=>{if(e.target===$('overlay'))closeModal();});

    setPeriod('90');
    (function(){
      const h=new URLSearchParams((location.hash||'').replace(/^#/,''));
      if(h.get('type')==='recovery' && h.get('access_token')){
        window.__recoveryToken=h.get('access_token');
        $('login').classList.add('hidden'); $('app').classList.add('hidden'); $('setpw').classList.remove('hidden');
        history.replaceState(null,'',location.pathname);
        return;
      }
      if(token()) loadBookings(); else show('login');
    })();
  </script>
</body>
</html>
