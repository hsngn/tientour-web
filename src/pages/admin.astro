    async function createReservation(){
      const name=$('cName').value.trim(), email=$('cEmail').value.trim(), wa=$('cWa').value.trim();
      $('createErr').textContent='';
      if(!name||(!email&&!wa)){ $('createErr').textContent='Name and an email or WhatsApp are required.'; return; }
      const btn=$('cSave'); btn.disabled=true;
      try{
        const r=await fetch(API+'/create',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+token()},
          body:JSON.stringify({ customer_name:name, email, whatsapp:wa, tour_slug:$('cTour').value, option:$('cOption').value,
            travelers:$('cPax').value, status:$('cStatus').value, start_date:$('cStart').value||null, end_date:$('cEnd').value||null,
            departure_city:$('cDep').value||null, return_city:$('cRet').value||null, amount:$('cAmount').value||null, country:$('cCountry').value||null,
            amount_paid:$('cPaid').value||0, language:$('cLang').value, message:$('cMsg').value||null })});
        if(r.status===401){ logout(); return; }
