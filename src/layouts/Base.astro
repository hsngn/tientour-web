---
import Seo from '../components/Seo.astro';
import { t } from '../i18n/ui';
import '../styles/global.css';
const { title, description, lang, jsonld } = Astro.props;
const path = Astro.url.pathname;
const pathFor = (l) => path.replace(/^\/(en|fr|vi)/, '/' + l);
const enPath = pathFor('en');
const frPath = pathFor('fr');
const L = (s) => `/${lang}${s}`;
const items = [
  ['nav_home', L('/')],
  ['nav_tours', L('/tours')], ['nav_private', L('/private-car')], ['nav_riders', L('/#riders')], ['nav_rental', L('/#rental')],
  ['nav_guide', L('/#guide')], ['nav_reviews', L('/reviews')],
];
---
<!doctype html>
<html lang={lang}>
  <head><Seo title={title} description={description} lang={lang} jsonld={jsonld} /></head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={L('/')} aria-label="Tien Tour Ha Giang Loop"><img src="/logo.png" alt="Tien Tour Ha Giang Loop" class="logo-img" width="203" height="34" /></a>
        <nav class="main">
          {items.map(([k,href])=>(<a class="lk" href={href}>{t(lang,k)}</a>))}
          <span class="langsw">
            <a href={enPath} class={lang==='en'?'on':''}>EN</a>
            <a href={frPath} class={lang==='fr'?'on':''}>FR</a>
          </span>
          <a class="btn btn-forest" href={L('/book')}>{t(lang,'nav_book')}</a>
        </nav>
        <button class="burger" aria-label="Menu" onclick="document.getElementById('mnav').classList.toggle('open')">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div id="mnav">
        {items.map(([k,href])=>(<a href={href}>{t(lang,k)}</a>))}
        <a href={L('/book')} style="color:var(--rust)">{t(lang,'nav_book')}</a>
        <a href={enPath}>EN</a><a href={frPath}>FR</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site"><div class="wrap">
      <img src="/logo-white.png" alt="Tien Tour Ha Giang Loop" class="logo-img foot" width="200" height="34" />
      <p>{t(lang,'footer_op')}</p>
      <div class="social">
