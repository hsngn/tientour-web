      </div>
      <p class="flinks"><a href={`/${lang}/bus`}>{lang==='fr'?'Bus pour Ha Giang':'Bus to Ha Giang'}</a> · <a href={`/${lang}/guide`}>{t(lang,'nav_guide')}</a> · <a href={`/${lang}/reviews`}>{t(lang,'nav_reviews')}</a> · <a href={`/${lang}/book`}>{t(lang,'nav_book')}</a></p>
      <p class="lic">International tourism license n° __________</p>
    </div></footer>
  </body>
</html>
