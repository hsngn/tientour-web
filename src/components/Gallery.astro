---
const { lang } = Astro.props;
const L = lang==='fr'
  ? { e:'En images', t:'Des moments, pas des cartes postales', s:'Nos voyageurs, nos guides, la vraie boucle de Ha Giang.' }
  : { e:'In pictures', t:'Real moments, not postcards', s:'Our travelers, our guides, the real Ha Giang Loop.' };
const pics = [
  { src:'/photos/p2.jpg', alt: lang==='fr'?'Chez l’habitant avec une famille locale':'Homestay with a local family' },
  { src:'/photos/p8.jpg', alt: lang==='fr'?'Sur la route de la boucle de Ha Giang':'Riding the Ha Giang Loop' },
  { src:'/photos/p7.jpg', alt: lang==='fr'?'Pause au-dessus d’un col':'Resting above a mountain pass' },
  { src:'/photos/p6.jpg', alt: lang==='fr'?'Un guide local montre le chemin':'A local guide showing the way' },
  { src:'/photos/p1.jpg', alt: lang==='fr'?'Rizières verdoyantes':'Green rice fields' },
  { src:'/photos/p5.jpg', alt: lang==='fr'?'Point de vue sur les montagnes':'Mountain viewpoint' },
];
---
<section class="gallery-sec"><div class="wrap">
  <div class="eyebrow">{L.e}</div>
  <h2 class="title">{L.t}</h2>
  <p class="sub">{L.s}</p>
  <div class="gal-grid">
    {pics.map((p)=>(<figure><img src={p.src} alt={p.alt} loading="lazy" /></figure>))}
  </div>
</div></section>

<style is:global>
  .gal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}
  .gal-grid figure{margin:0;border-radius:16px;overflow:hidden;aspect-ratio:4/3;background:var(--cream-2)}
  .gal-grid img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
  .gal-grid figure:hover img{transform:scale(1.06)}
  @media(max-width:760px){ .gal-grid{grid-template-columns:repeat(2,1fr)} }
</style>
