---
import { t } from '../i18n/ui';
const { lang, head = true } = Astro.props;
const data = {
  en:[["“The Ha Giang Loop is an adventure that will stay forever in our hearts. We had very good drivers who knew the road by heart — special thanks to Dak, I felt completely safe the entire journey. The food was great and the evenings memorable.”","🇬🇧 Juliette K. · Google review"],
      ["“Truly one of the best experiences of my life. As a solo traveler I was stressed, but the group was amazing and every driver was kind and drove safely. The homestays and hotel were lovely and the food beyond expectations.”","🇫🇷 Nadège E. · Google review"],
      ["“Clearly one of the best parts of my trip to Vietnam. They organised my arrival from Sapa perfectly and even booked my bus to Cao Bang. Special mention to Thinh, my driver and guide — always smiling and caring.”","🇫🇷 Philippine L. · Google review"]],
  fr:[["« Clairement une des meilleures expériences de mon voyage au Vietnam ! Ils ont parfaitement organisé mon arrivée depuis Sapa et même réservé mon bus pour Cao Bang. Mention spéciale à Thinh, mon driver et guide, toujours souriant et bienveillant. »","🇫🇷 Philippine L. · Avis Google"],
      ["« La boucle de Ha Giang est une aventure qui restera à jamais dans nos cœurs. Nos drivers connaissaient la route par cœur — merci à Dak, je me suis sentie totalement en sécurité. La nourriture était excellente et les soirées mémorables. »","🇬🇧 Juliette K. · Avis Google"],
      ["« Vraiment l’une des meilleures expériences de ma vie. Solo et un peu stressée au départ, j’ai eu un groupe génial et des drivers adorables et prudents. Les homestays et l’hôtel étaient superbes et la cuisine au-delà de mes attentes. »","🇫🇷 Nadège E. · Avis Google"]],
  vi:[["“The Ha Giang Loop is an adventure that will stay forever in our hearts. Special thanks to my driver Dak — I felt completely safe the entire journey.”","🇬🇧 Juliette K. · Google review"],
      ["“Truly one of the best experiences of my life. Every driver was kind and drove safely, the homestays were lovely and the food beyond expectations.”","🇫🇷 Nadège E. · Google review"],
      ["“One of the best parts of my trip to Vietnam. Special mention to Thinh, my driver and guide — always smiling and caring.”","🇫🇷 Philippine L. · Google review"]],
};
const list = data[lang] ?? data.en;
---
<section class="rev"><div class="wrap">
  {head && (
    <div class="sec-head">
      <div><div class="eyebrow">{t(lang,'reviews_eyebrow')}</div>
        <h2 class="title">{t(lang,'reviews_title')}</h2></div>
      <a class="alllink" href={`/${lang}/reviews`}>{t(lang,'reviews_all')}</a>
    </div>
  )}
  <div class="grid">
    {list.map((r)=>(
      <figure class="card" style="margin:0"><div class="stars">★★★★★</div>
        <blockquote>{r[0]}</blockquote><figcaption class="who">{r[1]}</figcaption></figure>
    ))}
  </div>
</div></section>
