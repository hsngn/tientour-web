---
import { t } from '../i18n/ui';
const { lang } = Astro.props;
const roleEN='Easy Rider & Guide', roleFR='Easy Rider & guide', roleVI='Tài xế & hướng dẫn';
const names=['bao','den','thang','thinh','tuan'];
const disp={bao:'Bảo', den:'Dền', thang:'Thắng', thinh:'Thịnh', tuan:'Tuấn'};
const roles={en:roleEN, fr:roleFR, vi:roleVI};
const role=roles[lang] ?? roleEN;
---
<section class="riders" id="riders"><div class="wrap">
  <div class="lead">
    <div><div class="eyebrow">{t(lang,'riders_eyebrow')}</div>
      <h2>{t(lang,'riders_title')}</h2></div>
    <p>{t(lang,'riders_lead')}</p>
  </div>
  <div class="row">
    {names.map((n)=>(
      <div class="rider">
        <div class="av"><img src={`/riders/${n}.jpg`} alt={disp[n]} loading="lazy" />
          <span class="langs"><span>EN</span><span>VN</span></span></div>
        <h3>{disp[n]}</h3><div class="role">{role}</div>
      </div>
    ))}
  </div>
</div></section>
